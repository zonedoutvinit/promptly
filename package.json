{
  "name": "promptly",
  "version": "1.1.5",
  "description": "Seamlessly run, compare, and interact with local and cloud LLMs.",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zonedoutvinit/promptly.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext ts,tsx",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [
    "ai",
    "llm",
    "electron",
    "productivity",
    "developer-tools"
  ],
  "author": {
    "name": "Vinit Damodar",
    "email": "damodarvinit425@gmail.com"
  },
  "license": "GPL-3.0",
  "type": "commonjs",
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.promptly.app",
    "files": [
      "out/**/*",
      "public/**/*"
    ],
    "win": {
      "icon": "public/favicon.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "public/icon.png",
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "public/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "zonedoutvinit",
      "repo": "promptly"
    }
  },
  "overrides": {
    "yauzl": "^3.3.1"
  }
}
